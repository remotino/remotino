+impl Processor {
+    /// Removes the bulk decompressor so it can be carried into a rebuilt processor.
+    ///
+    /// Bulk decompression is **stateful**: MPPC/NCRUSH/XCRUSH keep a history window that
+    /// must stay in lockstep with the server's compressor. A Deactivation-Reactivation
+    /// Sequence rebuilds this processor, and constructing a *fresh* decompressor there
+    /// resets the history to empty while the server keeps its own - every subsequent
+    /// decompression then yields garbage (invalid update types, absurd bytes-per-pixel,
+    /// wrong pointer mask sizes). Carry the existing instance over instead.
+    pub fn take_bulk_decompressor(&mut self) -> Option<BulkCompressor> {
+        self.bulk_decompressor.take()
+    }
+}
