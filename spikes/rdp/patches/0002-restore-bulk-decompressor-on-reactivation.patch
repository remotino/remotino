+/// Builds a bulk decompressor for the negotiated compression type, if any.
+///
+/// Exposed publicly because the FastPath processor must be rebuilt after a
+/// Deactivation-Reactivation Sequence (a window resize triggers one). Callers that
+/// rebuild it need to restore the decompressor too - dropping it leaves the client
+/// advertising compression it can no longer decode, and the next compressed PDU is
+/// parsed as raw bytes.
+pub fn make_bulk_decompressor(compression_type: Option<PduCompressionType>) -> Option<BulkCompressor> {
+    compression_type.and_then(|ct| {
+        let bulk_ct = to_bulk_compression_type(ct);
+        match BulkCompressor::new(bulk_ct) {
+            Ok(compressor) => {
+                info!(compression_type = %bulk_ct, "Bulk decompressor initialized for FastPath");
+                Some(compressor)
+            }
+            Err(e) => {
+                tracing::error!(error = %e, "Failed to create bulk decompressor, compression disabled");
+                None
+            }
+        }
+    })
+}
